# Copy to .env and fill in real values. Never commit the real .env file.

# --- mailbox (bridge and/or wormhole) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=assistant@example.com
IMAP_PASSWORD=your-app-password
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_USER=assistant@example.com
SMTP_PASSWORD=your-app-password
SMTP_PORT=465

# --- bridge: HiveMind hub this bridge forwards utterances to ---
HIVEMIND_HOST=hivemind-core
HIVEMIND_PORT=5678
HIVEMIND_ACCESS_KEY=
# optional: comma-separated allowlist; leave blank to answer everyone
ALLOWED_SENDERS=

# --- wormhole: peer-to-peer protocol transport ---
MY_SECRET=
PEER_SECRET=
PEER_EMAIL=
PEER_PUBKEY_PATH=/keys/peer.asc
KEY_PATH=/keys/local.asc

POLL_SECONDS=30
